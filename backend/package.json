{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/security.test.ts tests/configuration.test.ts",
    "test:integration": "node ../tests/release-runner.mjs --integration",
    "test:configuration": "vitest run tests/configuration.test.ts",
    "test:database-operations": "node ../tests/release-runner.mjs --check-database && vitest run tests/database-operations.test.ts tests/preflight-measurements.test.ts",
    "db:check": "node dist/db/cli.js check",
    "db:preflight": "node dist/db/cli.js preflight",
    "db:migrate": "node dist/db/cli.js migrate",
    "db:check:source": "ts-node src/db/cli.ts check",
    "db:preflight:source": "ts-node src/db/cli.ts preflight",
    "db:migrate:source": "ts-node src/db/cli.ts migrate"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.20.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "6.0.2",
    "vitest": "^4.1.11"
  }
}
