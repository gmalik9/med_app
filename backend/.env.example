PORT=5000
# Replace placeholders privately; URL-encode the database password.
DATABASE_URL=postgresql://user:<database-password>@localhost:5432/med_app_db
JWT_SECRET=<independent-random-signing-secret>
JWT_REFRESH_SECRET=<independent-random-refresh-secret>
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_TIMEOUT_MINUTES=15
# Required only for explicit development seeding. Never use a production password.
SEED_PASSWORD=<development-seed-password>
